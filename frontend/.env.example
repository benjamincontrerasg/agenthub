# AgentHub Environment Configuration Example
# NOTA: Nunca almacenes credenciales secretas ni API Keys privadas en variables VITE_ públicas.

# URL base del servicio Backend REST
VITE_API_URL=https://api.agenthub.dev/v1

# URL del servidor WebSocket para eventos en tiempo real
VITE_WS_URL=wss://api.agenthub.dev/ws

# Modo simulación (true para desarrollo local con mock data, false para backend en vivo)
VITE_USE_MOCK=true

