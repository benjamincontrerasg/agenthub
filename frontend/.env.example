# NEXORA Environment Configuration Example
# NOTA: Nunca almacenes credenciales secretas ni API Keys privadas en variables VITE_ públicas.
# En desarrollo local: copia este archivo a .env.local (ignorado por Git).

# URL base del servicio Backend REST (en Docker con Nginx proxy para /v1 basta "/v1")
VITE_API_URL=http://localhost:3001/v1

# URL del servidor WebSocket para eventos en tiempo real
VITE_WS_URL=ws://localhost:3001/ws

# Modo de datos:
# - false: Conecta con el backend real en Fastify (persistencia SQLite en /data/nexora.db).
# - true:  Modo simulación en memoria sin necesidad de levantar backend.
VITE_USE_MOCK=false


