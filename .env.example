# ═══════════════════════════════════════════════════════════
# NEXORA — Variables de Entorno para Docker Compose
# ═══════════════════════════════════════════════════════════
# Copia este archivo como .env antes de ejecutar docker compose up
#   cp .env.example .env

# Clave de cifrado para AES-256-GCM (mínimo 32 caracteres)
# Genera una clave segura:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AVISO: Cambiar ENCRYPTION_KEY invalida las API keys ya cifradas en una base existente.
ENCRYPTION_KEY=clave-falsa-cifrado-minimo-32-caracteres-para-docker-compose-12345

# Clave secreta para firma y verificación de tokens JWT (mínimo 32 caracteres)
# Debe ser distinta de ENCRYPTION_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=clave-falsa-jwt-secret-minimo-32-caracteres-para-docker-compose-67890
