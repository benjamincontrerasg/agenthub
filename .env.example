# ═══════════════════════════════════════════════════════════
# NEXORA — Variables de Entorno para Docker Compose
# ═══════════════════════════════════════════════════════════
# Copia este archivo como .env antes de ejecutar docker compose up
#   cp .env.example .env

# Clave de cifrado para AES-256-GCM (mínimo 32 caracteres)
# Genera una clave segura:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_generate_a_secure_64_char_hex_key
