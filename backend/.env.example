# ═══════════════════════════════════════════════════════════
# NEXORA Backend — Variables de Entorno
# ═══════════════════════════════════════════════════════════
# Copia este archivo como .env y configura los valores.
#   cp .env.example .env

# Puerto del servidor HTTP Fastify
PORT=3001

# Host de escucha (127.0.0.1 para entorno local seguro Zero-Trust)
HOST=127.0.0.1

# Ruta a la base de datos SQLite (relativa al directorio backend/)
DATABASE_URL=./data/nexora.db

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# ⚠️  CLAVE DE CIFRADO MAESTRA (OBLIGATORIA)
# Se usa para cifrar las API Keys con AES-256-GCM y derivación HKDF (formato v2).
# Genera una clave segura con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_generate_a_secure_64_char_hex_key

# Clave de cifrado anterior (opcional, para rotación sin downtime con scripts/rotate-key.ts)
# PREVIOUS_ENCRYPTION_KEY=

# Token de autenticación Bearer para comunicarse con el Local Agent Bridge (OBLIGATORIO)
BRIDGE_TOKEN=CHANGE_ME_bridge_bearer_token_secret_min_32_chars

# Lista blanca de hostnames privados permitidos para SSRF (separados por coma)
ALLOWED_PRIVATE_HOSTS=localhost,127.0.0.1
