# ═══════════════════════════════════════════════════════════
# NEXORA Backend — Variables de Entorno
# ═══════════════════════════════════════════════════════════
# Copia este archivo como .env y configura los valores.
#   cp .env.example .env

# Puerto del servidor HTTP Fastify
PORT=3001

# Host de escucha (0.0.0.0 para aceptar conexiones externas)
HOST=0.0.0.0

# Ruta a la base de datos SQLite (relativa al directorio backend/)
DATABASE_URL=./data/nexora.db

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# ⚠️  CLAVE DE CIFRADO — OBLIGATORIA (mínimo 32 caracteres)
# Se usa EXCLUSIVAMENTE para cifrar las API Keys con AES-256-GCM.
# Genera una clave criptográficamente segura con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AVISO: Cambiar ENCRYPTION_KEY invalida las API keys ya cifradas en una base de datos existente.
ENCRYPTION_KEY=clave-falsa-cifrado-minimo-32-caracteres-para-desarrollo-12345

# ⚠️  CLAVE SECRETA JWT — OBLIGATORIA (mínimo 32 caracteres)
# Se usa EXCLUSIVAMENTE para firmar y verificar tokens de sesión JWT (HS256).
# Debe ser estrictamente distinta de ENCRYPTION_KEY.
# Genera una clave criptográficamente segura con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=clave-falsa-jwt-secret-minimo-32-caracteres-para-desarrollo-67890

# Token para autenticación con el Local Agent Bridge
BRIDGE_TOKEN=bridge-token-falso-para-desarrollo-local-32chars
