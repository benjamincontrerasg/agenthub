# ═══════════════════════════════════════════════════════════
# AgentHub Backend — Variables de Entorno
# ═══════════════════════════════════════════════════════════
# Copia este archivo como .env y configura los valores.
#   cp .env.example .env

# Puerto del servidor HTTP Fastify
PORT=3001

# Host de escucha (0.0.0.0 para aceptar conexiones externas)
HOST=0.0.0.0

# Ruta a la base de datos SQLite (relativa al directorio backend/)
DATABASE_URL=./data/agenthub.db

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# ⚠️  CLAVE DE CIFRADO — OBLIGATORIO CAMBIAR EN PRODUCCIÓN
# Se usa para cifrar las API Keys de proveedores con AES-256-GCM (derivada con scrypt).
# Genera una clave segura con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_generate_a_secure_64_char_hex_key
