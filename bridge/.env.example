# ═══════════════════════════════════════════════════════════
# NEXORA Local Agent Bridge — Variables de Entorno
# ═══════════════════════════════════════════════════════════
# Puerto de escucha del Bridge
BRIDGE_PORT=8765

# Host de escucha (127.0.0.1 requerido para prevenir DNS rebinding)
BRIDGE_HOST=127.0.0.1

# ⚠️ TOKEN BEARER COMPARTIDO OBLIGATORIO
# Compara en tiempo constante con timingSafeEqual para autenticar llamadas de NEXORA
BRIDGE_TOKEN=CHANGE_ME_bridge_bearer_token_secret_min_32_chars

# Timeout por defecto para llamadas JSON-RPC (en milisegundos, default: 30000, máx: 300000)
BRIDGE_TIMEOUT_MS=30000

# Directorios autorizados para ejecución y confinamiento con realpath (separados por coma)
BRIDGE_ALLOWED_DIRS=./mcp-servers,./tools
